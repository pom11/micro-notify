  resource "typing-extensions" do
    url "https://files.pythonhosted.org/packages/f6/cc/6253133b5bb138fc3306cebfbda2c520f545d36b5be2c7255cc528bb45d6/typing_extensions-4.16.0.tar.gz"
    sha256 "dc983d19a509c94dba722ee6abd33940f7c05a89e243c47e907eb4db6f1a43e5"
  end

  resource "urllib3" do
    url "https://files.pythonhosted.org/packages/e3/05/b17359e1cefb4f909b5e40b1b90a496d987258916dbbf88e842c729f510e/urllib3-2.8.0.tar.gz"
    sha256 "63bf2ead4c879426ebf22ef2a781eeb4aa3b4ae798a0435506f8687fd5bb9b63"
  end

  # The sdists above build through PEP 517 backends (setuptools, flit-core,
  # hatchling, maturin) that pip resolves in a build-isolated environment,
  # which needs the network. Same trade-off homebrew-core's awscli and
  # pom11/homebrew-hscc make for their pinned sdists.
  allow_network_access! :build

  def install
    # The sdist extracts to micro_notify-{{VERSION}}/, so `buildpath` is the
    # project root (pyproject.toml + src/).
    odie "expected the release tarball to carry pyproject.toml at its root" unless (buildpath/"pyproject.toml").exist?

    venv = virtualenv_create(libexec/"venv", python3, system_site_packages: false)
    # Pinned deps first, each by its staged sdist (--no-deps under std_pip_args),
    # then the project itself — whose console scripts (`micro-notify`,
    # `mnotify`) are what pip_install_and_link symlinks into bin.
    venv.pip_install resources
    venv.pip_install_and_link buildpath
  end

  test do
    # --version is argparse's eager version action: it prints
    # `mnotify <version>` and exits 0 before any config, keychain or network
    # access, so this proves the venv, both console scripts and the import
    # chain without touching Microsoft at all.
    assert_match version.to_s, shell_output("#{bin}/micro-notify --version")
    assert_match version.to_s, shell_output("#{bin}/mnotify --version")
    # The guardrails and the dry-run flag are the contract for agents; a build
    # whose help lacks them is not the CLI this tap promises.
    help_text = shell_output("#{bin}/mnotify mail send --help")
    assert_match "--dry-run", help_text
    assert_match "--to", help_text
  end
end
