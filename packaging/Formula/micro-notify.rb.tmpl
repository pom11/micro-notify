# frozen_string_literal: true

# micro-notify — Homebrew Python virtualenv formula (design section 5).
#
# This file is a TEMPLATE: scripts/release.py fills {{VERSION}}, {{URL}} and
# {{SHA256}} from the release tarball it hashed and writes the result to
# <tap>/Formula/micro-notify.rb. The placeholder-free text is already valid
# Ruby (`ruby -c` passes with the placeholders substituted) so the template in
# git is the same structure that ships.
#
# Pattern reference: pom11/homebrew-hscc (same virtualenv shape) and
# homebrew-core's awscli (pinned sdists, build-isolated PEP 517 backends).
class MicroNotify < Formula
  include Language::Python::Virtualenv

  desc "CLI for agents and scripts: Microsoft 365 mail via Graph, Teams via Workflows webhooks"
  homepage "https://github.com/pom11/micro-notify"
  url "{{URL}}"
  version "{{VERSION}}"
  sha256 "{{SHA256}}"
  license "MIT"

  livecheck do
    url "https://github.com/pom11/micro-notify/releases"
    strategy :github_latest
  end

  depends_on "python@3.12"
  depends_on "pkgconf" => :build
  depends_on "rust" => :build       # cryptography ships a Rust extension; its sdist needs a cargo
  depends_on "openssl@3"            # cryptography links OpenSSL

  # The FULL runtime closure of msal>=1.28 + httpx>=0.27 on CPython 3.12, as
  # sdists with sha256, so `--no-deps` pip installs (Homebrew's std_pip_args)
  # never resolve a version off the network. Update together with pyproject
  # dependencies, never piecemeal.
  resource "anyio" do
    url "https://files.pythonhosted.org/packages/a9/d2/f4d173e22df740bc37b1db102b386ba719b66e95b0f0d751f556b387e6d2/anyio-4.15.1.tar.gz"
    sha256 "9f28306018cbd6d329e64a36d58256edff76dd996fe423bc957326e578b82a94"
  end

  resource "certifi" do
